# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Specific source formats
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Docker and config files
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf
CMakeLists.txt text eol=lf
